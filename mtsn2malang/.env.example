APP_NAME="MTsN 2 Kota Malang"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://mtsn2kotamalang.sch.id

# Kosongkan agar URL file storage bersifat relatif (mengikuti host permintaan).
# Isi hanya bila memakai CDN/domain aset terpisah, contoh: https://cdn.contoh.id
ASSET_URL=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mtsn2malang
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie sesi hanya dikirim lewat HTTPS (situs production sudah full HTTPS)
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail.mtsn2kotamalang.sch.id
MAIL_PORT=587
MAIL_USERNAME=mtsnmalang2adm@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="mtsnmalang2adm@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI Integration
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini

# Google Analytics
GOOGLE_ANALYTICS_ID=

# reCAPTCHA
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_SECRET=

# OTP Login (aktif/nonaktif diatur di Pengaturan Website → Keamanan)
OTP_EXPIRY_MINUTES=5

# Password super admin awal saat `php artisan db:seed` (kosong = dibuat acak)
ADMIN_DEFAULT_PASSWORD=
