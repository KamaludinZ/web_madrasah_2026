# Jangan pernah ikut masuk image
.env
.env.*
!.env.example
.git
.github
.idea
.vscode
.phpunit.cache
.phpunit.result.cache

# Dibangun ulang di dalam Dockerfile
vendor
node_modules
public/build
public/hot
public/storage

# Data runtime — disediakan oleh volume, bukan image
storage/app/*
!storage/app/.gitignore
!storage/app/public/.gitignore
!storage/app/private/.gitignore
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*
storage/logs/*
bootstrap/cache/*.php

# Tidak dibutuhkan saat produksi
tests
phpunit.xml
*.zip
*.tar
*.tar.gz
*.sql
